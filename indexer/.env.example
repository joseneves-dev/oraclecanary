# Solana RPC endpoint. Get a free key at https://helius.dev
RPC_URL=https://api.mainnet-beta.solana.com
# Optional Jupiter API key (free at https://portal.jup.ag); empty uses the keyless lite-api.jup.ag
JUPITER_API_KEY=
# Same database as the Symfony app (started with: cd web && docker compose up -d)
DATABASE_URL=postgresql://app:!ChangeMe!@127.0.0.1:5433/app
# Seconds between checks
CHECK_INTERVAL_SECONDS=60
# A health change is recorded only after lasting this many seconds.
ALERT_CONFIRM_SECONDS=180
