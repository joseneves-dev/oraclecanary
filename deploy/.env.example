# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Public domain; Caddy gets an HTTPS certificate for it. Use ":80" to test locally over HTTP.
SERVER_NAME=oraclecanary.com

# Generate each with: openssl rand -hex 32
APP_SECRET=
POSTGRES_PASSWORD=

# Solana RPC with getProgramAccounts support, e.g. https://mainnet.helius-rpc.com/?api-key=...
RPC_URL=

# 300s (5 min) fits the Helius free plan (1M credits/month); 60s needs a paid plan.
CHECK_INTERVAL_SECONDS=300
HEALTH_MAX_DATA_AGE_SECONDS=1200

# Telegram alerts: the bot's token from @BotFather (leave empty to disable), and the channel it posts
# to, where the bot must be an administrator allowed to post.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@OracleCanaryAlerts
# Reserves with less supplied than this get no alert.
ALERT_MIN_SUPPLY_USD=10000

# Folder with the built web app (index.html, assets/).
UI_DIST=./ui
